{
  "compilerOptions": {
    "target": "es6",
    "module": "node16",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node16"
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts"
  ]
}
